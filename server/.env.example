# Pick one provider. The app runs without this file (offline parser), but the
# agent gives better answers with a model.
LLM_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible gateway (for example a sponsor's endpoint):
# LLM_MODEL=openai:gpt-4o-mini
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Optional: generated sound effects from ElevenLabs (otherwise the app synthesises them)
# ELEVENLABS_API_KEY=
